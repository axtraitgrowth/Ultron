# ==============================================================================
# ULTRON AI AGENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://ultron_admin:ultron_secure_password_2026@localhost:5432/ultron_db?schema=public

# Redis & Job Queues (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=ultron_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=ultron_super_secure_refresh_jwt_secret_key_2026
JWT_REFRESH_EXPIRATION=30d

# Desktop Agent Pairing Secret
DESKTOP_AGENT_PAIRING_SECRET=ultron_desktop_pairing_secret_key_2026

# AI Provider API Keys
DEFAULT_AI_PROVIDER=fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Storage Configuration (FileStorageProvider)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Agent Execution & Safety Boundaries
MAX_AGENT_RECURSION_STEPS=15
ENABLE_HUMAN_IN_THE_LOOP=true
CONFIRMATION_TIMEOUT_SECONDS=60
